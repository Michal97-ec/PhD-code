#smooth
plot_city_mortality_smooth <- function(data) {
  
  # Convert city columns to long format
  data_long <- data %>%
    pivot_longer(
      cols = -Year,
      names_to = "City",
      values_to = "Collisions"
    )
  
  # Calculate total mortality across all cities for each year
  data_total <- data_long %>%
    group_by(Year) %>%
    summarise(
      Collisions = sum(Collisions, na.rm = TRUE)
    )
  
  p <- ggplot(data_long, aes(x = Year, y = Collisions, color = City)) +
    
    
    # Smooth trend for each city
    geom_smooth(
      method = "loess",
      se = FALSE,
      linewidth = 1
    ) +
    
    # Total mortality line
    geom_smooth(
      data = data_total,
      aes(x = Year, y = Collisions, color = "Total"),
      method = "loess",
      se = FALSE,
      linewidth = 1.2,
      inherit.aes = FALSE
    )+
    
    scale_x_continuous(
      limits = c(2014, 2023),
      breaks = 2014:2023,
      expand = c(0.01, 0)
    ) +
    
    scale_y_continuous(
      limits = c(0, 1000),
      breaks = seq(0, 1000, by = 100),
      expand = expansion(mult = c(0, 0.02))
    )+
    
    # Explicit colours for the three cities
    scale_color_manual(
      values = c(
        "Kraków" = "#1B9E77",
        "Niepołomice" = "#D95F02",
        "Wieliczka" = "#7570B3",
        "Total" = "black"
      ),
      breaks = c("Kraków", "Niepołomice", "Wieliczka", "Total")
    ) +
    
    labs(
      title = "Number of Yearly Collisions in Each City",
      x = "Year",
      y = "Number of Collisions",
      color = "City"
    ) +
    
    theme_classic(base_size = 12) +
    theme(
      plot.title = element_text(
        hjust = 0.5,
        face = "bold",
        size = 14
      ),
      
      axis.text = element_text(
        size = 11,
        color = "black"
      ),
      
      axis.title = element_text(size = 12),
      
      axis.line = element_line(linewidth = 0.6),
      axis.ticks = element_line(linewidth = 0.5),
      
      legend.position = "top",
      legend.title = element_text(size = 11),
      legend.text = element_text(size = 10),
      
      panel.grid = element_blank(),
      
      plot.margin = margin(10, 15, 10, 10)
    )
  
  return(p)
}

