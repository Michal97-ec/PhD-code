# ===== FIT GAM =====

gam_counts_combined <- summary_df %>%
  group_by(Species, Season, City, TimeOfDay, Year) %>%
  summarise(count = n(), .groups = "drop") %>%
  left_join(gamtotal_per_species, by = "Species") %>%
  mutate(
    proportion = pmax(pmin(count / species_total, 0.9999), 0.0001),
    Season     = factor(Season),
    City       = factor(City),
    TimeOfDay  = factor(TimeOfDay),
    Year       = as.numeric(Year)
  )

print(gam_counts_combined)

