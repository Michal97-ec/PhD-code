# Fit GAM per species


gam_results <- lapply(species_list, function(sp) {
  
  sp_data <- gam_counts_combined %>%
    dplyr::filter(Species == sp)
  
  cat("\nRows for", sp, ":", nrow(sp_data), "\n")
  
  if (nrow(sp_data) < 15) {
    cat("Skipping", sp, "— too few rows\n")
    return(NULL)
  }
  
  model <- gam(
    proportion ~ Season + City + TimeOfDay + s(Year, k = 4),
    data   = sp_data,
    family = betar(link = "logit"),
    method = "REML"
  )
  
  list(species = sp, model = model, summary = summary(model))
}) %>%
  purrr::compact()

