# ===== STEP 1: PREPARE DATA FRAME =====

target_species <- c("red_fox", "marten", "wild_boar", "roe_deer", "hedgehog")

# Filter to top 5 species and drop unneeded columns
glmm_base_df <- summary_df %>%
  dplyr::filter(Species %in% target_species) %>%
  dplyr::select(City, Year, Season, TimeOfDay, Species) %>%
  mutate(
    Species   = factor(Species),
    Season    = factor(Season),
    City      = factor(City),
    TimeOfDay = factor(TimeOfDay),
    Year      = factor(Year)
  )

print(head(glmm_base_df))
print(table(glmm_base_df$Species))

# ===== STEP 2: COUNT COLLISIONS PER CELL =====

# Total per species (denominator)
glmm_total_per_species <- glmm_base_df %>%
  group_by(Species) %>%
  summarise(species_total = n(), .groups = "drop")

# Count per species, city, year, season, timeofday
glmm_counts <- glmm_base_df %>%
  group_by(Species, City, Year, Season, TimeOfDay) %>%
  summarise(count = n(), .groups = "drop") %>%
  left_join(glmm_total_per_species, by = "Species") %>%
  mutate(
    failures  = species_total - count,
    Species   = factor(Species),
    Season    = factor(Season,    levels = c("spring", "summer", "autumn", "winter")),
    City      = factor(City),
    TimeOfDay = factor(TimeOfDay, levels = c("light", "dark")),
    Year      = factor(Year)
  )

print(head(glmm_counts))
cat("\nRows per species:\n")
print(table(glmm_counts$Species))

# ===== STEP 3: FIT GLMM PER SPECIES =====

glmm_results <- lapply(target_species, function(sp) {
  
  sp_data <- glmm_counts %>%
    dplyr::filter(Species == sp)
  
  cat("\n========================================\n")
  cat("Species:", sp, "— rows:", nrow(sp_data), "\n")
  cat("========================================\n")
  
  if (nrow(sp_data) < 10) {
    cat("Skipping", sp, "— too few rows\n")
    return(NULL)
  }
  
  # Fit GLMM: Season + City + TimeOfDay as fixed effects, Year as random effect
  model <- tryCatch({
    glmer(
      cbind(count, failures) ~ Season + City + TimeOfDay + (1 | Year),
      data   = sp_data,
      family = binomial(link = "logit"),
      control = glmerControl(optimizer = "bobyqa", optCtrl = list(maxfun = 2e5))
    )
  }, error = function(e) {
    cat("Model failed for", sp, ":", e$message, "\n")
    return(NULL)
  })
  
  if (is.null(model)) return(NULL)
  
  print(summary(model))
  
  list(
    species = sp,
    model   = model,
    data    = sp_data
  )
}) %>%
  purrr::compact()

names(glmm_results) <- sapply(glmm_results, function(x) x$species)

# ===== STEP 4: EXTRACT RESULTS TABLE =====

glmm_table <- lapply(names(glmm_results), function(sp) {
  
  model <- glmm_results[[sp]]$model
  coefs <- as.data.frame(summary(model)$coefficients)
  coefs$Term    <- rownames(coefs)
  coefs$p_value <- coefs[[4]]
  coefs$Species <- sp           # add Species here
  rownames(coefs) <- NULL
  coefs$p_adj   <- p.adjust(coefs$p_value, method = "BH")
  coefs$sig     <- case_when(
    coefs$p_adj < 0.001 ~ "***",
    coefs$p_adj < 0.01  ~ "**",
    coefs$p_adj < 0.05  ~ "*",
    TRUE                ~ "ns"
  )
  coefs %>% dplyr::select(Species, Term, Estimate, `Std. Error`, `z value`, p_value, p_adj, sig)
}) %>%
  bind_rows()

print(glmm_table)
