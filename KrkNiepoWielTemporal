plot_df <- Daytimeyear_df %>%
  mutate(City = str_to_title(str_replace_all(City, " ", "")))

binned_df <- plot_df %>%
  mutate(bin = cut(radians, breaks = seq(0, 2*pi, length.out = 49), 
                   include.lowest = TRUE, labels = FALSE)) %>%
  group_by(City, bin) %>%
  summarise(count = n(), .groups = "drop") %>%
  mutate(bin_mid = (bin - 0.5) / 48 * 2 * pi)

# Fit LOESS per City and find peak hour

peak_hours <- binned_df %>%
  group_by(City) %>%
  group_modify(~ {
    
    # Sort by radians first
    .x <- .x %>% arrange(bin_mid)
    
    # LOESS
    fit <- loess(count ~ bin_mid, data = .x, span = 0.3)
    fitted_vals <- predict(fit, newdata = .x)
    
    n <- length(fitted_vals)
    
    # Identify local maxima
    is_peak <- c(
      FALSE,
      fitted_vals[2:(n - 1)] > fitted_vals[1:(n - 2)] &
        fitted_vals[2:(n - 1)] > fitted_vals[3:n],
      FALSE
    )
    
    peaks <- data.frame(
      bin_mid        = .x$bin_mid[is_peak],
      fitted         = fitted_vals[is_peak],
      raw_collisions = .x$count[is_peak]
    )
    
    if (nrow(peaks) == 0) {
      return(data.frame())
    }
    
    # Return primary peak only
    peaks %>%
      slice_max(fitted, n = 1, with_ties = FALSE) %>%
      mutate(peak_rank = "Primary peak")
    
  }) %>%
  ungroup() %>%
  
  # Convert radians to hours
  mutate(
    peak_hour = (bin_mid / (2 * pi)) * 24,
    peak_hour = peak_hour %% 24,
    
    peak_hh = floor(peak_hour),
    peak_mm = round((peak_hour - peak_hh) * 60),
    
    peak_hh = ifelse(peak_mm == 60, peak_hh + 1, peak_hh),
    peak_mm = ifelse(peak_mm == 60, 0,            peak_mm),
    peak_hh = peak_hh %% 24,
    
    peak_time = sprintf("%02d:%02d", peak_hh, peak_mm)
  ) %>%
  
  select(
    City,
    peak_rank,
    peak_time,
    peak_hour,
    bin_mid,
    fitted,
    raw_collisions
  )


