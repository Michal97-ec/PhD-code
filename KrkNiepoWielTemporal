Top5Seasonsplots <- lapply(city_list, function(ct) {
  
  lapply(species_list, function(sp) {
    
    Top5Seasonsplots_data <- Top5Seasons_df %>%
      dplyr::filter(City == ct, Species == sp)
    
    if (nrow(Top5Seasonsplots_data) == 0) return(NULL)
    
    # BH-corrected pairwise Wilcoxon
    pwc <- Top5Seasonsplots_data %>%
      wilcox_test(WVC ~ Season, p.adjust.method = "BH") %>%
      add_significance() %>%
      add_xy_position(x = "Season")  # calculates bracket positions
    
    ggboxplot(
      Top5Seasonsplots_data,
      x          = "Season",
      y          = "WVC",
      fill       = "White",
      color      = "black",
      add        = "none",
      
    ) +
      
      # Add BH-corrected significance brackets, hide non-significant
      stat_pvalue_manual(
        pwc %>% dplyr::filter(p.adj < 0.05),
